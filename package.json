{
  "name": "garden-inspections",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "server": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web && node scripts/build-pwa.mjs"
  },
  "dependencies": {
    "expo": "~57.0.24",
    "expo-camera": "~57.0.5",
    "expo-secure-store": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3"
  }
}
